# Copy to .env.local and fill in real values. Never commit real values here:
# this file is tracked by git (see .gitignore).

# Supabase — get these from your project:
# Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Service-role key (SECRET — bypasses RLS). Only needed for admin/server code.
# Never expose in the browser, never commit the real value.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public base URL of this deployment, used for auth redirects, Stripe return
# URLs and links in emails. Required on Vercel production (the app throws
# without it); previews fall back to their deployment URL, local dev to
# http://localhost:3000.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Stripe — Dashboard → Developers → API keys. Use sk_test_… keys anywhere
# that isn't production.
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
# Signing secret of the webhook endpoint pointing at /api/webhooks/stripe
# (Dashboard → Developers → Webhooks, or `stripe listen` locally).
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-signing-secret

# Resend — get this from https://resend.com → API Keys. Used for direct
# transactional email sends outside of Supabase Auth's own SMTP flows.
RESEND_API_KEY=your-resend-api-key

# ── Calendly (Book a demo scheduling) ────────────────────────────────────────
# Public scheduling link surfaced from the Book-a-demo dialog (defaults to the
# client link in landing-content.ts if unset).
NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/your-account/30min
# Signing key from the Calendly webhook subscription — /api/webhooks/calendly
# returns 501 until this is set, then verifies each invitee.created payload.
CALENDLY_WEBHOOK_SIGNING_KEY=your-calendly-webhook-signing-key

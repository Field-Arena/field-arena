# ── Calendly (Book a demo scheduling) ────────────────────────────────────────
# Public scheduling link surfaced from the Book-a-demo dialog (defaults to the
# client link in landing-content.ts if unset).
NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/ameforward/30min
# Signing key from the Calendly webhook subscription — /api/webhooks/calendly
# returns 501 until this is set, then verifies each invitee.created payload.
CALENDLY_WEBHOOK_SIGNING_KEY=
